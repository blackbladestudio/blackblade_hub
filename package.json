{
  "name": "blackblade-hub",
  "version": "1.2.0",
  "description": "BlackBlade Hub - 工作室统一工作台",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "pack": "node scripts/build.mjs && electron-builder --dir",
    "dist": "node scripts/build.mjs && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.blackblade.hub",
    "productName": "BlackBlade Hub",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "minio": "^8.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.9.3"
  }
}
